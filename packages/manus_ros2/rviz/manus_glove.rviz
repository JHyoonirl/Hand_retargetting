Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /MANUS glove skeleton1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: manus
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic: /manus_glove_markers
      Name: MANUS glove skeleton
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: manus
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.65
      Focal Point:
        X: 0
        Y: 0
        Z: 0.09
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: manus
      Value: Orbit (rviz)
      Yaw: 1.570796
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  X: 60
  Y: 60
